<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCKH.Components.TrangThaiChipView">

    <Border x:Name="ChipBorder" Padding="8,4" StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12"/>
        </Border.StrokeShape>
        <Label x:Name="ChipLabel" FontSize="10" FontAttributes="Bold"/>
    </Border>

</ContentView>