<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCKH.Components.RoleChipView">

    <Border x:Name="ChipBorder" 
        Padding="12,6" 
        StrokeThickness="0.5"
        Stroke="#CCCCCC"
        BackgroundColor="Transparent">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20"/>
        </Border.StrokeShape>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <Border.Triggers>
            <DataTrigger TargetType="Border" 
                     Binding="{Binding IsSelected, Source={RelativeSource AncestorType={x:Type ContentView}}}" 
                     Value="True">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="White" />
            </DataTrigger>
        </Border.Triggers>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnStepTapped" />
        </Border.GestureRecognizers>

        <Label x:Name="ChipLabel" 
           FontSize="12" 
           HorizontalOptions="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" 
                         Binding="{Binding IsSelected, Source={RelativeSource AncestorType={x:Type ContentView}}}" 
                         Value="True">
                    <Setter Property="TextColor" Value="#4facfe" />
                    <Setter Property="FontAttributes" Value="Bold" />
                </DataTrigger>
                <DataTrigger TargetType="Label" 
                         Binding="{Binding IsSelected, Source={RelativeSource AncestorType={x:Type ContentView}}}" 
                         Value="False">
                    <Setter Property="TextColor" Value="White" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>

</ContentView>