<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NCKH.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NCKH.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="NCKH">

    <!-- Login -->
    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="LoginPage"/>

    <FlyoutItem Title="Dashboard" Route="DashboardPage">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Hồ Sơ" Route="HoSoListPage">
        <ShellContent ContentTemplate="{DataTemplate views:HoSoListPage}" />
    </FlyoutItem>

    <!-- Kiểm tra quá trình -->
    <ShellContent Title="Kiểm tra"
                  ContentTemplate="{DataTemplate views:KiemTraQuaTrinhPage}"
                  Route="KiemTraQuaTrinhPage"/>

    <!-- Thông báo -->
    <ShellContent Title="Thông báo"
                  ContentTemplate="{DataTemplate views:ThongBaoPage}"
                  Route="ThongBaoPage"/>

</Shell>
