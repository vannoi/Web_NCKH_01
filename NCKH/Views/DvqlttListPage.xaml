<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:NCKH.Components"
             xmlns:viewmodels="clr-namespace:NCKH.ViewModels"
             x:Class="NCKH.Views.DvqlttListPage"
             Title="Preliminary Check"
             BackgroundColor="#F4F7FC">

    <ContentPage.BindingContext>
        <viewmodels:HoSoListViewModel />
    </ContentPage.BindingContext>

    <Grid ColumnDefinitions="240, *">
        <VerticalStackLayout Grid.Column="0" Padding="20" Spacing="10">
            <VerticalStackLayout.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4facfe" Offset="0.1" />
                    <GradientStop Color="#6859E2" Offset="1.0" />
                </LinearGradientBrush>
            </VerticalStackLayout.Background>

            <Label Text="KHCN SYSTEM" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,25"
                   HorizontalOptions="Center"/>

            <components:RoleChipView LabelText="Quản lý hồ sơ" IsSelected="False" Tapped="OnQuanLyHoSoTapped"/>
            <components:RoleChipView LabelText="Kiểm tra sơ bộ" IsSelected="True" />
            <components:RoleChipView LabelText="Thông báo" IsSelected="False" />

            <BoxView VerticalOptions="FillAndExpand" Color="Transparent" />
        </VerticalStackLayout>

        <Grid Grid.Column="1" RowDefinitions="Auto, *">

            <Frame Grid.Row="0" 
                   HeightRequest="100" 
                   Padding="25,0" 
                   HasShadow="False" 
                   CornerRadius="0" 
                   BorderColor="Transparent">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4facfe" Offset="0.1" />
                        <GradientStop Color="#00f2fe" Offset="0.5" />
                        <GradientStop Color="#6859E2" Offset="1.0" />
                    </LinearGradientBrush>
                </Frame.Background>

                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Preliminary Check" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           TextColor="White"/>
                    <Label Text="Đơn vị Quản lý Trực tiếp" 
                           FontSize="14" 
                           TextColor="#E0E0E0"/>
                </VerticalStackLayout>
            </Frame>

            <Grid Grid.Row="1" Padding="20">
                <Frame CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#DDD" BackgroundColor="White">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="1.5*, 2*, 1*, 0.8*, 0.8*, 1*, 1*" Padding="15" BackgroundColor="#F8F9FA">
                            <Label Text="TITLE" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" Grid.Column="0"/>
                            <Label Text="DESCRIPTION" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" Grid.Column="1"/>
                            <Label Text="LECTURER" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" Grid.Column="2"/>
                            <Label Text="ATTACH" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" HorizontalTextAlignment="Center" Grid.Column="3"/>
                            <Label Text="MY ATT" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" HorizontalTextAlignment="Center" Grid.Column="4"/>
                            <Label Text="STATUS" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" Grid.Column="5"/>
                            <Label Text="ACTION" FontAttributes="Bold" FontSize="10" TextColor="#7F8C8D" HorizontalTextAlignment="Center" Grid.Column="6"/>
                        </Grid>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding DanhSachHoSo}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="1.5*, 2*, 1*, 0.8*, 0.8*, 1*, 1*" Padding="15" VerticalOptions="Center">

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="#F1F4F9" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>

                                        <Label Text="{Binding TieuDe}" TextColor="Black" FontSize="12" VerticalOptions="Center" Grid.Column="0" FontAttributes="Bold"/>
                                        <Label Text="{Binding MoTa}" TextColor="#666" FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" Grid.Column="1"/>
                                        <Label Text="{Binding TenGiangVien}" TextColor="Black" FontSize="12" VerticalOptions="Center" Grid.Column="2"/>

                                        <Button Grid.Column="3" 
                                                Text="{Binding SoLuongTepChung, StringFormat='📁 {0}'}" 
                                                FontSize="11" TextColor="#185FA5" BackgroundColor="#E6F1FB"
                                                CornerRadius="15" HeightRequest="32" Padding="5,0"
                                                Clicked="OnViewAttachmentsClicked" />

                                        <Button Grid.Column="4" 
                                                Text="{Binding SoLuongTepRieng, StringFormat='📄 {0}'}" 
                                                FontSize="11" TextColor="#5F5E5A" BackgroundColor="#F1EFE8"
                                                CornerRadius="15" HeightRequest="32" Padding="5,0"
                                                Clicked="OnViewMyAttachmentsClicked" />

                                        <components:TrangThaiChipView TrangThai="{Binding TrangThai}" Grid.Column="5" VerticalOptions="Center"/>

                                        <HorizontalStackLayout Grid.Column="6" Spacing="8" HorizontalOptions="Center">
                                            <Button Text="✔" BackgroundColor="#28a745" TextColor="White" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0"/>
                                            <Button Text="✖" BackgroundColor="#dc3545" TextColor="White" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0"
                                                    Clicked="OnReturnApplicationClicked" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Frame>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>