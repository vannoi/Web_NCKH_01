<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCKH.Views.LoginPage"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8F0FE" Offset="0.0"/>
                <GradientStop Color="#EEF2FF" Offset="0.5"/>
                <GradientStop Color="#F0EBFF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <ScrollView>
            <VerticalStackLayout Padding="16,25" VerticalOptions="Center">
                <Border StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.WidthRequest>
                        <OnIdiom x:TypeArguments="x:Double" Phone="-1" Desktop="540"/>
                    </Border.WidthRequest>
                    <Border.HorizontalOptions>
                        <OnIdiom x:TypeArguments="LayoutOptions" Phone="Fill" Desktop="Center"/>
                    </Border.HorizontalOptions>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#6366F1" Offset="0,10" Radius="30" Opacity="0.15"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,*">

                        <!-- PHẦN HEADER GRADIENT -->
                        <Grid Grid.Row="0" HeightRequest="260">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F8EF7" Offset="0.0"/>
                                    <GradientStop Color="#38BDF8" Offset="0.5"/>
                                    <GradientStop Color="#818CF8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Ellipse WidthRequest="120" HeightRequest="120"
                                     HorizontalOptions="End" VerticalOptions="Start"
                                     Margin="0,-30,-20,0" Opacity="0.1" Fill="White"/>
                            <VerticalStackLayout Padding="24" Spacing="0" VerticalOptions="Center">
                                <Label Text="QUẢN LÝ NCKH" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Trường ĐH Công nghệ Đồng Nai"
                                       FontSize="14" TextColor="#D1E9FF" Margin="0,2,0,18"/>
                                <Image Source="logo.png"
                                       WidthRequest="75" HeightRequest="75"
                                       HorizontalOptions="Start" Margin="0,0,0,15"/>
                                <BoxView HeightRequest="3" WidthRequest="40" BackgroundColor="#60A5FA"
                                         HorizontalOptions="Start" CornerRadius="1.5"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- PHẦN FORM ĐĂNG NHẬP -->
                        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="24,32">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Chào mừng quay lại!" FontSize="24" FontAttributes="Bold"
                                       TextColor="#1E293B" Margin="0,0,0,6"/>
                                <Label Text="Vui lòng đăng nhập để tiếp tục"
                                       FontSize="13" TextColor="#64748B" Margin="0,0,0,28"/>

                                <!-- EMAIL -->
                                <Label Text="Tài khoản / Email" FontSize="12" FontAttributes="Bold"
                                       TextColor="#475569" Margin="4,0,0,8"/>
                                <Border Padding="12,0" HeightRequest="54" StrokeThickness="1"
                                        Stroke="#E2E8F0" BackgroundColor="#F8FAFC" Margin="0,0,0,18">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Entry x:Name="EmailEntry"
                                           Placeholder="MSSV hoặc Email"
                                           PlaceholderColor="#94A3B8"
                                           Keyboard="Email"
                                           VerticalOptions="Center"
                                           FontSize="15"/>
                                </Border>

                                <!-- MẬT KHẨU + NÚT MẮT -->
                                <Label Text="Mật khẩu" FontSize="12" FontAttributes="Bold"
                                       TextColor="#475569" Margin="4,0,0,8"/>
                                <Border Padding="12,0" HeightRequest="54" StrokeThickness="1"
                                        Stroke="#E2E8F0" BackgroundColor="#F8FAFC" Margin="0,0,0,28">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Entry x:Name="PasswordEntry"
                                               IsPassword="True"
                                               Placeholder="••••••••"
                                               PlaceholderColor="#94A3B8"
                                               VerticalOptions="Center"
                                               FontSize="15"/>
                                        <Button x:Name="EyeButton"
                                                Grid.Column="1"
                                                Text="👁"
                                                FontSize="18"
                                                BackgroundColor="Transparent"
                                                TextColor="#94A3B8"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                Padding="0"
                                                Clicked="OnTogglePasswordClicked"/>
                                    </Grid>
                                </Border>

                                <!-- NÚT ĐĂNG NHẬP -->
                                <Button Text="ĐĂNG NHẬP" TextColor="White" FontSize="16"
                                        FontAttributes="Bold" HeightRequest="56" CornerRadius="14"
                                        Clicked="OnDangNhapClicked" Margin="0,0,0,20">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4F8EF7" Offset="0"/>
                                            <GradientStop Color="#818CF8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>

                                <!-- QUÊN MẬT KHẨU -->
                                <Label Text="Quên mật khẩu?" FontSize="14" TextColor="#4F8EF7"
                                       FontAttributes="Bold" HorizontalOptions="Center" Padding="10">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
