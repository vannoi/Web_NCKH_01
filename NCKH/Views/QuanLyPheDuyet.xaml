<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:NCKH.Components"
             xmlns:vm="clr-namespace:NCKH.ViewModels"
             x:Class="NCKH.Views.QuanLyPheDuyetPage"
             BackgroundColor="#F5F6FA"
             Title="Quản lý Phê duyệt NCKH">

    <Grid ColumnDefinitions="250, *">
        <components:SidebarView Grid.Column="0" ActivePage="NCKH" />

        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <Frame Grid.Row="0" BackgroundColor="White" Margin="20,10" Padding="15" CornerRadius="10" HasShadow="False">
                <Grid ColumnDefinitions="*, Auto">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="QUẢN LÝ PHÊ DUYỆT HỒ SƠ" FontSize="18" FontAttributes="Bold" TextColor="#4E31AA"/>
                        <Border BackgroundColor="#E8F5E9" Padding="8,2" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5"/>
                            </Border.StrokeShape>
                            <Label Text="Chế độ: Giảng viên" TextColor="Green" FontSize="11" FontAttributes="Bold" 
                                   IsVisible="{Binding LaGiangVien}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="Học kỳ 1 - 2024" VerticalOptions="Center" TextColor="#64748B" FontSize="13"/>
                </Grid>
            </Frame>

            <ScrollView Grid.Row="1" Padding="20">
                <VerticalStackLayout Spacing="25">
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15">
                        <Frame Grid.Column="0" BackgroundColor="White" HasShadow="False" CornerRadius="12" Padding="15">
                            <HorizontalStackLayout Spacing="12">
                                <Border BackgroundColor="#F0F5FF" WidthRequest="45" HeightRequest="45" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22"/>
                                    </Border.StrokeShape>
                                    <Label Text="📋" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Tổng hồ sơ" TextColor="#64748B" FontSize="11"/>
                                    <Label Text="24" FontSize="18" FontAttributes="Bold" TextColor="#1E293B"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1" BackgroundColor="White" HasShadow="False" CornerRadius="12" Padding="15">
                            <HorizontalStackLayout Spacing="12">
                                <Border BackgroundColor="#FFF7ED" WidthRequest="45" HeightRequest="45" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22"/>
                                    </Border.StrokeShape>
                                    <Label Text="⏳" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Chờ duyệt" TextColor="#64748B" FontSize="11"/>
                                    <Label Text="05" FontSize="18" FontAttributes="Bold" TextColor="#EA580C"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame Grid.Column="2" BackgroundColor="White" HasShadow="False" CornerRadius="12" Padding="15">
                            <HorizontalStackLayout Spacing="12">
                                <Border BackgroundColor="#F0FDF4" WidthRequest="45" HeightRequest="45" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22"/>
                                    </Border.StrokeShape>
                                    <Label Text="✅" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Đã duyệt" TextColor="#64748B" FontSize="11"/>
                                    <Label Text="19" FontSize="18" FontAttributes="Bold" TextColor="#16A34A"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <Frame BackgroundColor="White" CornerRadius="12" HasShadow="False" Padding="12">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <SearchBar Grid.Column="0" Placeholder="Tìm tên đề tài..." FontSize="13" HeightRequest="40" BackgroundColor="#F8F9FF"/>
                            <Button Grid.Column="1" Text="Xuất Excel" BackgroundColor="#4E31AA" TextColor="White" FontSize="12" WidthRequest="120"/>
                        </Grid>
                    </Frame>

                    <Frame CornerRadius="15" HasShadow="False" BackgroundColor="White" Padding="0">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" BackgroundColor="#F8F9FF" Padding="15" ColumnDefinitions="*, 100, 150, 120">
                                <Label Text="Tên Đề tài" FontAttributes="Bold" TextColor="#475569" FontSize="13"/>
                                <Label Text="Số giờ" Grid.Column="1" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" FontSize="13"/>
                                <Label Text="Trạng thái" Grid.Column="2" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" FontSize="13"/>
                                <Label Text="Thao tác" Grid.Column="3" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" FontSize="13"/>
                            </Grid>

                            <CollectionView Grid.Row="1" ItemsSource="{Binding DanhSachHoSo}" Margin="0,0,0,10">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout>
                                            <Grid Padding="15" ColumnDefinitions="*, 100, 150, 120">
                                                <Label Text="{Binding TenHoSo}" 
                                                       TextColor="#1E293B" 
                                                       FontAttributes="Bold" 
                                                       FontSize="14"
                                                       VerticalOptions="Center" 
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"/>

                                                <Label Grid.Column="1" 
                                                       Text="{Binding GioDatDuoc, StringFormat='{0}h'}" 
                                                       HorizontalTextAlignment="Center" 
                                                       VerticalOptions="Center" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#4E31AA"/>

                                                <Frame Grid.Column="2" Padding="10,4" CornerRadius="8" BackgroundColor="#FFF4E5" 
                                                       HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                                                    <Label Text="{Binding TrangThai}" TextColor="#FF9800" FontSize="11" FontAttributes="Bold"/>
                                                </Frame>

                                                <Button Grid.Column="3" 
                                                        Text="Phê duyệt" 
                                                        BackgroundColor="#4E31AA" 
                                                        CornerRadius="6" 
                                                        HeightRequest="32" 
                                                        FontSize="11"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:QuanLyNghienCuuViewModel}}, Path=LaGiangVien}" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuanLyNghienCuuViewModel}}, Path=DuyetHoSoCommand}" 
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>

                                            <BoxView HeightRequest="1" Color="#EDF2F7" Margin="15,0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>