<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:NCKH.Components"
             x:Class="NCKH.Views.DashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Desktop=240}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <components:SidebarView Grid.Column="0" 
                                Grid.ColumnSpan="{OnIdiom Phone=2, Desktop=1}"
                                ActivePage="Dashboard" 
                                ZIndex="999"/>

        <ScrollView Grid.Column="1" Margin="{OnIdiom Phone='0,20,0,0', Desktop='0'}">
            <VerticalStackLayout Padding="28" Spacing="18">

                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Chào mừng trở lại, Nguyễn Văn A!👋"
                               FontSize="22" FontAttributes="Bold" TextColor="#1E293B"/>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Năm học 2024-2025 · Kỳ II" 
                               TextColor="#64748B" FontSize="13"/>
                            <Label Text="Hôm nay bạn có 2 hồ sơ mới cần xử lý" 
                               TextColor="#4F46E5" FontSize="13" FontAttributes="Bold"
                               IsVisible="{OnIdiom Phone=True, Desktop=True}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="12,8" StrokeThickness="0"
                            BackgroundColor="White" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🔔" FontSize="16"/>
                            <Border WidthRequest="18" HeightRequest="18" BackgroundColor="#EF4444"
                                    StrokeThickness="0" VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9"/>
                                </Border.StrokeShape>
                                <Label Text="3" FontSize="9" TextColor="White" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToThongBao"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <FlexLayout Direction="Row" 
                            Wrap="{OnIdiom Phone=Wrap, Desktop=NoWrap}" 
                            JustifyContent="SpaceBetween"
                            AlignContent="Stretch"
                            AlignItems="Stretch">

                    <Border Padding="20" StrokeThickness="0" 
                            Margin="{OnIdiom Phone='0,0,0,12', Desktop='0,0,8,0'}"
                            FlexLayout.Basis="{OnIdiom Phone='100%', Desktop='32%'}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EEF2FF" Offset="0"/>
                                <GradientStop Color="#E0E7FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="#5A67D8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="⏱" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Tổng giờ đạt" TextColor="#6366F1" FontSize="12"
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="185h" FontSize="32" FontAttributes="Bold" TextColor="#3730A3"/>
                            <ProgressBar Progress="0.62" ProgressColor="#5A67D8"
                                         BackgroundColor="#C7D2FE" HeightRequest="6"/>
                            <Label Text="62% định mức (300h)" TextColor="#818CF8" FontSize="11"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="20" StrokeThickness="0" 
                            Margin="{OnIdiom Phone='0,0,0,12', Desktop='0,0,8,0'}"
                            FlexLayout.Basis="{OnIdiom Phone='100%', Desktop='32%'}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFF7ED" Offset="0"/>
                                <GradientStop Color="#FFEDD5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="#F97316">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="📁" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Đang duyệt" TextColor="#EA580C" FontSize="12"
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="05" FontSize="32" FontAttributes="Bold" TextColor="#C2410C"/>
                            <Label Text="hồ sơ chờ xét duyệt" TextColor="#FB923C" FontSize="11"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="20" StrokeThickness="0" 
                            Margin="{OnIdiom Phone='0,0,0,12', Desktop='0'}"
                            FlexLayout.Basis="{OnIdiom Phone='100%', Desktop='32%'}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="#FFFFFF20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🔔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Thông báo" TextColor="#C4B5FD" FontSize="12"
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="12" FontSize="32" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="thông báo chưa đọc" TextColor="#DDD6FE" FontSize="11"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToThongBao"/>
                        </Border.GestureRecognizers>
                    </Border>
                </FlexLayout>

                <Border Padding="24" BackgroundColor="White" StrokeThickness="0.5" Stroke="#E2E8F0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="20">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Tiến độ NCKH năm học 2024-2025"
                                       FontAttributes="Bold" FontSize="16" TextColor="#1E293B"/>
                                <Label Text="Thống kê giờ NCKH theo tháng" FontSize="12" TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Padding="10,6" StrokeThickness="0"
                                    BackgroundColor="#EEF2FF" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="2024 - 2025" TextColor="#5A67D8" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10" HeightRequest="160">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="4">
                                <Label Text="20h" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Border HeightRequest="40" BackgroundColor="#C7D2FE" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,0,0"/>
                                    </Border.StrokeShape>
                                </Border>
                                <Label Text="T9" FontSize="11" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="4">
                                <Label Text="35h" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Border HeightRequest="70" BackgroundColor="#A5B4FC" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,0,0"/>
                                    </Border.StrokeShape>
                                </Border>
                                <Label Text="T10" FontSize="11" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="End" Spacing="4">
                                <Label Text="50h" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Border HeightRequest="100" BackgroundColor="#818CF8" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,0,0"/>
                                    </Border.StrokeShape>
                                </Border>
                                <Label Text="T11" FontSize="11" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" VerticalOptions="End" Spacing="4">
                                <Label Text="30h" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Border HeightRequest="60" BackgroundColor="#A5B4FC" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,0,0"/>
                                    </Border.StrokeShape>
                                </Border>
                                <Label Text="T12" FontSize="11" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="4" VerticalOptions="End" Spacing="4">
                                <Label Text="25h" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Border HeightRequest="50" BackgroundColor="#C7D2FE" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,0,0"/>
                                    </Border.StrokeShape>
                                </Border>
                                <Label Text="T1" FontSize="11" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="5" VerticalOptions="End" Spacing="4">
                                <Label Text="25h" FontSize="10" TextColor="#5A67D8" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Border HeightRequest="50" StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#5A67D8" Offset="0"/>
                                            <GradientStop Color="#818CF8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,4,0,0"/>
                                    </Border.StrokeShape>
                                </Border>
                                <Label Text="T2 ●" FontSize="11" TextColor="#5A67D8" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,-12,0,0"/>
                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="12" HeightRequest="12" Color="#5A67D8" CornerRadius="3" VerticalOptions="Center"/>
                                <Label Text="Giờ NCKH đạt được" FontSize="12" TextColor="#64748B"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView WidthRequest="12" HeightRequest="12" Color="#E2E8F0" CornerRadius="3" VerticalOptions="Center"/>
                                <Label Text="Mục tiêu tháng" FontSize="12" TextColor="#64748B"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="24" BackgroundColor="White" StrokeThickness="0.5" Stroke="#E2E8F0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Hồ sơ gần đây"
                                    FontAttributes="Bold" FontSize="16" TextColor="#1E293B"/>
                            <Label Grid.Column="1" Text="Xem tất cả →" TextColor="#5A67D8"
                                    FontSize="13" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGoToHoSoList"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#EEF2FF" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="📄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Bài báo quốc tế Scopus Q1 - IEEE" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                                <Label Text="Nộp ngày 10/01/2025" FontSize="12" TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="8,4" BackgroundColor="#FEF3C7" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label Text="Đang xét" FontSize="11" FontAttributes="Bold" TextColor="#D97706"/>
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="0.5" BackgroundColor="#F1F5F9"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#F0FDF4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="📝" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Đề tài NCKH cấp Cơ sở 2024" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                                <Label Text="Nộp ngày 05/12/2024" FontSize="12" TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="8,4" BackgroundColor="#F0FDF4" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label Text="Đã duyệt" FontSize="11" FontAttributes="Bold" TextColor="#16A34A"/>
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="0.5" BackgroundColor="#F1F5F9"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="#FFF7ED" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="📚" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Biên soạn giáo trình Lập trình Mobile" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                                <Label Text="Nộp ngày 20/11/2024" FontSize="12" TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="8,4" BackgroundColor="#FEF2F2" StrokeThickness="0" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label Text="Cần bổ sung" FontSize="11" FontAttributes="Bold" TextColor="#DC2626"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>