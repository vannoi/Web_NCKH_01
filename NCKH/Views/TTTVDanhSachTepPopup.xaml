<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NCKH.Views.TTTVDanhSachTepPopup"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">
    <Grid>
        <!-- Overlay bấm ra ngoài để đóng -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped"/>
        </Grid.GestureRecognizers>

        <Border BackgroundColor="White" StrokeShape="RoundRectangle 16"
                WidthRequest="420" VerticalOptions="Center" HorizontalOptions="Center"
                Padding="24" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="30" Opacity="0.15"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">

                <!-- Tiêu đề -->
                <HorizontalStackLayout>
                    <Label x:Name="LabelTieuDe" FontSize="17" FontAttributes="Bold"
                           TextColor="#1E293B" HorizontalOptions="FillAndExpand"/>
                    <Label Text="✕" FontSize="18" TextColor="#94A3B8">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDongClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Đường kẻ -->
                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>

                <!-- Danh sách file -->
                <CollectionView x:Name="ListFile" MaximumHeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1" Stroke="#E2E8F0" Padding="12,10" Margin="0,4">
                                <HorizontalStackLayout Spacing="12">
                                    <Label x:Name="IconFile" Text="📄" FontSize="20" VerticalOptions="Center"/>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding .}" TextColor="#1E293B" FontSize="14"
                                               FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                        <Label Text="Nhấn để tải xuống" TextColor="#94A3B8" FontSize="11"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" HorizontalOptions="Center" Spacing="8">
                            <Label Text="📂" FontSize="36" HorizontalTextAlignment="Center"/>
                            <Label Text="Không có tệp đính kèm" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" FontSize="14"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Đường kẻ -->
                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>

                <!-- Nút đóng -->
                <Button Text="Đóng" BackgroundColor="#5A67D8" TextColor="White"
                        CornerRadius="8" HeightRequest="42" FontAttributes="Bold"
                        Clicked="OnDongClicked"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
